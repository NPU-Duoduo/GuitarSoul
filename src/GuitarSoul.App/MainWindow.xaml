                        </Grid>
                        <CheckBox x:Name="StageMotionPreview" Content="看看动作 · 模拟节奏，无声音" Checked="StageMotion_Changed" Unchecked="StageMotion_Changed" Margin="0,12,0,10" Style="{StaticResource PanelCheck}"/>
                        <Button x:Name="UseStageButton" Content="一起弹时用这套" Style="{StaticResource PrimaryAction}" Click="UseStage_Click" HorizontalAlignment="Left" MinHeight="36" Padding="14,0" FontSize="12.5"/>
                      </StackPanel>
                    </Border>
                    <ListBox x:Name="StageSelector" SelectionChanged="Stage_Changed" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="演奏成就图鉴">
                      <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,6,8"/>
                          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Background="#28332A" BorderBrush="#45513F" BorderThickness="1" CornerRadius="10" Padding="8,8"><ContentPresenter/></Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#33482F"/><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Forest}"/></Trigger>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#B4BFB0"/></Trigger>
                              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#9A691F"/><Setter TargetName="Row" Property="BorderThickness" Value="2"/></Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate></Setter.Value></Setter>
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel MinHeight="120">
                          <pet:StagePortrait Stage="{Binding Style}" IsLocked="{Binding Locked}" Width="66" Height="66" IsHitTestVisible="False"/>
                          <TextBlock Text="{Binding Title}" Foreground="{StaticResource PanelInk}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                          <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource AccentInk}" FontSize="12" Margin="0,3,0,0" TextAlignment="Center"/>
                          <TextBlock Text="{Binding Hint}" Margin="2,5,2,0" TextAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Locked}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </StackPanel>
                      </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="接入吉他，在「陪伴」中开始倾听，正常演奏就有机会发现。电脑播放与动作预览不会解锁。" Style="{StaticResource Caption}" Margin="0,8,0,12"/>
                    <TextBlock x:Name="StageActive" Style="{StaticResource Caption}"/>
                    <Button x:Name="RestoreStageButton" Content="恢复日常形态" Click="RestoreStage_Click" Style="{StaticResource GhostAction}" HorizontalAlignment="Left" Margin="0,10,0,0" MinHeight="34" Padding="13,0" FontSize="12.5"/>
                    <TextBlock x:Name="StageFeedback" TextWrapping="Wrap" Foreground="{StaticResource AccentInk}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="RetryAchievementButton" Content="重试保存成就" Visibility="Collapsed" Click="RetryAchievement_Click" Style="{StaticResource GhostAction}" HorizontalAlignment="Left" Margin="0,8,0,0" MinHeight="34" Padding="13,0" FontSize="12.5"/>
                    <Expander x:Name="LegacyStageHistory" Header="旧版探索记录" Visibility="Collapsed" Style="{StaticResource QuietDisclosure}" Margin="0,12,0,0"><TextBlock x:Name="LegacyStageNotes" Style="{StaticResource Caption}" Margin="0,8,0,0"/></Expander>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem x:Name="SettingsTab" Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                  <StackPanel Margin="0,6,0,22">
                      <Expander x:Name="PerformanceDetails" Header="演奏辅助" Style="{StaticResource QuietDisclosure}" Margin="0,4,0,0">
                        <StackPanel Margin="0,0,0,8">
                          <Grid Margin="0,8,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="和弦记录 · 空闲重置" Foreground="#D4DDCB" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="ChordResetSecondsInput" Grid.Column="1" Text="15" LostFocus="ChordReset_Changed" KeyDown="ChordReset_KeyDown" MinHeight="30" VerticalContentAlignment="Center" Background="#132019" Foreground="#E7DFC8" BorderBrush="#61705A" Padding="8,2" AutomationProperties.Name="停止演奏多少秒后清空和弦记录"/>
                            <TextBlock Grid.Column="2" Text="秒 · 0关闭" Foreground="#AFBDA5" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                          </Grid>
                          <Expander x:Name="PlaybackOptions" Header="播放输出设备" Visibility="Collapsed" Style="{StaticResource QuietDisclosure}" Margin="0,4,0,0">
                        <StackPanel Margin="0,4,0,8" Background="#1A211D">
                          <ComboBox x:Name="OutputDevices" ItemTemplate="{StaticResource NameItem}" SelectionChanged="Output_SelectionChanged" Style="{StaticResource FieldCombo}" AutomationProperties.Name="伴奏输出设备"/>
                        </StackPanel>
                      </Expander>
                          <Expander x:Name="SoundDetails" Header="输入诊断" Style="{StaticResource QuietDisclosure}">
                            <StackPanel Margin="0,4,0,10">
                              <TextBlock x:Name="BeatStatus" Style="{StaticResource Caption}"/>
                              <TextBlock x:Name="ActivityLabel" Text="还没有开始听" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                              <TextBlock x:Name="RhythmStatus" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                            </StackPanel>
                          </Expander>
                        </StackPanel>
                      </Expander>
                    <Expander x:Name="DeviceSettings" IsExpanded="False" Style="{StaticResource QuietDisclosure}">
                      <Expander.Header><StackPanel Margin="0,2,0,2"><TextBlock Text="设备与校准" Style="{StaticResource SectionTitle}"/><TextBlock Text="输入通道、底噪校准、活动阈值" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Expander.Header>
                      <StackPanel Margin="0,6,0,14">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Text="输入声道与接收" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                          <Button Grid.Column="1" Content="刷新设备" Click="Refresh_Click" Style="{StaticResource GhostAction}" MinHeight="32" Padding="12,0" FontSize="12"/></Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                          <TextBlock x:Name="InputFormat" Text="请选择综合效果器或声卡，不会自动启用麦克风。" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                          <ComboBox Grid.Column="1" x:Name="InputChannels" ItemTemplate="{StaticResource NameItem}" SelectionChanged="InputChannel_Changed" AutomationProperties.Name="输入通道" Style="{StaticResource FieldCombo}" MinHeight="34"/></Grid>
                        <TextBlock x:Name="DeviceHint" Text="QME-10：使用录音/数据 USB 口。其他品牌也可直接选择输入设备。" Style="{StaticResource Caption}" Margin="0,10,0,12"/>
                        <StackPanel Orientation="Horizontal"><Button x:Name="CalibrateButton" Content="校准静音底噪" Click="Calibrate_Click" IsEnabled="False" Style="{StaticResource GhostAction}" MinHeight="34" Padding="13,0" FontSize="12.5"/><Button Content="导出设备诊断" Click="ExportDiagnostics_Click" Style="{StaticResource GhostAction}" Margin="8,0,0,0" MinHeight="34" Padding="13,0" FontSize="12.5"/></StackPanel>
                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Text="活动阈值" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                          <Slider Grid.Column="1" x:Name="Threshold" Minimum="-65" Maximum="-20" Value="-45" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Threshold_Changed" Margin="12,0" Style="{StaticResource PanelSlider}" AutomationProperties.Name="输入活动阈值"/>
                          <TextBlock Grid.Column="2" x:Name="ThresholdLabel" Text="−45 dB" Style="{StaticResource Caption}" Width="56" VerticalAlignment="Center"/></Grid>
                        <TextBlock x:Name="CalibrationText" Text="校准时保持琴弦安静；电平变化只说明有声音，不证明输入只有吉他。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                      </StackPanel>
                    </Expander>

                    <Expander Style="{StaticResource QuietDisclosure}">
                      <Expander.Header><StackPanel Margin="0,2,0,2"><TextBlock Text="猫的样子与动作" Style="{StaticResource SectionTitle}"/><TextBlock Text="花色、一起弹时拿的琴、表达性格、动作幅度" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Expander.Header>
                      <StackPanel Margin="0,6,0,14">
                        <ComboBox x:Name="SkinSelector" ItemTemplate="{StaticResource LabelItem}" SelectionChanged="Skin_Changed" AutomationProperties.Name="猫的皮肤" Style="{StaticResource FieldCombo}"/>
                        <TextBlock Text="一起弹时，拿这把琴" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                        <ComboBox x:Name="GuitarSelector" ItemTemplate="{StaticResource LabelItem}" SelectedValuePath="Guitar" SelectionChanged="Guitar_Changed" AutomationProperties.Name="摇滚猫吉他款式" Style="{StaticResource FieldCombo}"/>
                        <TextBlock x:Name="StageGuitarHint" Style="{StaticResource Caption}" Margin="0,8,0,14"/>
                        <TextBlock Text="它的表达性格" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ExpressionSelector" SelectedIndex="0" SelectionChanged="Expression_Changed" AutomationProperties.Name="猫的回应方式" Style="{StaticResource FieldCombo}"><ComboBoxItem Content="克制 · 话少一些，慢慢投入"/><ComboBoxItem Content="好奇 · 留意变化，更愿意加入"/></ComboBox>
                        <TextBlock Text="相同的琴声，它会用不同的动作和短句回应。可以随时调整，花色与共同记忆不受影响。" Style="{StaticResource Caption}" Margin="0,8,0,16"/>
                        <TextBlock Text="动作幅度" Style="{StaticResource FieldLabel}"/>
                        <Slider x:Name="MotionAmount" Minimum="0" Maximum="1" Value="0.7" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Motion_Changed" AutomationProperties.Name="猫的动作幅度" Style="{StaticResource PanelSlider}" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ReduceMotion" Content="减少动态效果，保留表情与姿态" Checked="ReduceMotion_Changed" Unchecked="ReduceMotion_Changed" Style="{StaticResource PanelCheck}"/>
                        <Border BorderBrush="{StaticResource PanelLine}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                          <StackPanel>
                            <CheckBox x:Name="PreviewMotion" Content="查看姿态预览（模拟节奏，无声音）" Checked="PreviewMotion_Changed" Unchecked="PreviewMotion_Changed" Style="{StaticResource PanelCheck}"/>
                            <ComboBox x:Name="PreviewMood" Margin="0,10,0,10" AutomationProperties.Name="预览猫的状态" Style="{StaticResource FieldCombo}">
                              <ComboBoxItem Content="等待 · 呼吸与眨眼"/>
                              <ComboBoxItem Content="倾听 · 抬耳与点头"/>
                              <ComboBoxItem Content="投入 · 踏爪与摇摆"/>
                              <ComboBoxItem Content="休息 · 蜷睡与轻呼吸"/>
                              <ComboBoxItem Content="一起弹 · 摇滚猫与吉他"/>
                            </ComboBox>
                            <TextBlock Text="稳定起音时跟拍；自由演奏时轻轻回应。显示的速度是起音间隔估计，可能与歌曲 BPM 不同。" Style="{StaticResource Caption}"/>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Expander>

                    <Expander Style="{StaticResource QuietDisclosure}">
                      <Expander.Header><StackPanel Margin="0,2,0,2"><TextBlock Text="猫的本地语言" Style="{StaticResource SectionTitle}"/><TextBlock Text="Qwen 只改写已确认的听感，不决定动作" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Expander.Header>
                      <StackPanel Margin="0,6,0,14">
                        <CheckBox x:Name="LocalLanguageToggle" Content="使用本机 Qwen 丰富短句" Checked="LocalLanguage_Changed" Unchecked="LocalLanguage_Changed" Style="{StaticResource PanelCheck}"/>
                        <TextBlock x:Name="LocalLanguageStatus" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="原始音频不会交给语言模型。Qwen 只看到温厚/明亮、长音/流动/密集、渐强/渐弱等结构化结果；超时、输出越界或模型缺失时自动使用原来的规则短句。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                      </StackPanel>
                    </Expander>

                    <Expander Style="{StaticResource QuietDisclosure}">
                      <Expander.Header><StackPanel Margin="0,2,0,2"><TextBlock Text="录音与手动收藏" Style="{StaticResource SectionTitle}"/><TextBlock Text="30 秒回溯缓存、手动收藏、测试录音" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Expander.Header>
                      <StackPanel Margin="0,6,0,14">
                        <CheckBox x:Name="RiffBufferToggle" Content="开启 30 秒回溯缓存" Checked="RiffBuffer_Changed" Unchecked="RiffBuffer_Changed" Style="{StaticResource PanelCheck}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="RiffBufferStatus" Text="开启后只在内存保留最近 30 秒，收藏时才写入文件。" Style="{StaticResource Caption}"/>
                        <Button x:Name="SaveRiffButton" Content="收藏刚才 30 秒" Click="SaveRiff_Click" IsEnabled="False" Style="{StaticResource PrimaryAction}" HorizontalAlignment="Left" Margin="0,12,0,8" MinHeight="36" Padding="14,0" FontSize="12.5"/>
                        <TextBlock Text="不足 30 秒时保存已有片段；保存所选通道，包含输入中混入的声音。" Style="{StaticResource Caption}"/>
                        <TextBlock Text="留下一小段，检查输入是否正确。" Style="{StaticResource SectionTitle}" Margin="0,16,0,0"/>
                        <TextBlock Text="从点击开始录制，保存当前所选通道；回溯保存请使用 Riff 收藏页。" Style="{StaticResource Caption}" Margin="0,8,0,12"/>
                        <StackPanel Orientation="Horizontal"><Button x:Name="RecordButton" Content="开始测试录音" Click="Record_Click" IsEnabled="False" Style="{StaticResource GhostAction}" MinHeight="34" Padding="13,0" FontSize="12.5"/><TextBlock x:Name="RecordingTime" Text="最长 60 秒" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Caption}"/></StackPanel>
                        <TextBlock x:Name="RecordingPath" Text="还没有保存测试录音。" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
                        <Button x:Name="OpenRecordingButton" Content="打开录音所在文件夹" Click="OpenRecording_Click" IsEnabled="False" Style="{StaticResource GhostAction}" HorizontalAlignment="Left" MinHeight="34" Padding="13,0" FontSize="12.5"/>
                      </StackPanel>
                    </Expander>

                    <Border BorderBrush="{StaticResource PanelLine}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,14,0,0">
                      <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="AboutVersion" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock Text="声音片段存在「文档 · Guitar Soul · Riffs」；设置、记忆和可选 Qwen 语言包存在本机数据目录。程序运行时不访问互联网，也不上传任何内容。" Style="{StaticResource Caption}" Margin="0,4,0,10"/>
                        <Button Content="打开数据目录" Click="OpenDataFolder_Click" Style="{StaticResource GhostAction}" HorizontalAlignment="Left" MinHeight="34" Padding="13,0" FontSize="12.5"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          <TextBlock x:Name="StatusMessage" Grid.Row="2" Text="准备就绪。" Foreground="#8B9488" FontSize="11" Margin="26,8,26,14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
      </Border>
    </Grid>

    <!-- window controls -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0">
      <Button Content="&#xE921;" Style="{StaticResource WindowButton}" Click="MinimizeWindow_Click" ToolTip="最小化" WindowChrome.IsHitTestVisibleInChrome="True"/>
      <Button Content="&#xE922;" Style="{StaticResource WindowButton}" Click="MaximizeWindow_Click" ToolTip="最大化" WindowChrome.IsHitTestVisibleInChrome="True"/>
      <Button Content="&#xE8BB;" Style="{StaticResource WindowButton}" Click="CloseWindow_Click" ToolTip="关闭" WindowChrome.IsHitTestVisibleInChrome="True"/>
    </StackPanel>

    <Border x:Name="AchievementToast" Grid.ColumnSpan="2" Panel.ZIndex="30" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,240,42" Background="#1D2B22" BorderBrush="#C7B37A" BorderThickness="1" CornerRadius="14" Padding="18,14" AutomationProperties.LiveSetting="Polite">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <pet:StagePortrait x:Name="AchievementToastPortrait" Width="78" Height="78" IsLocked="False" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="AchievementToastTitle" Foreground="#F5F2E7" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock x:Name="AchievementToastCharacter" Foreground="#C6D2C2" FontSize="13"/>
          <WrapPanel Margin="0,11,0,0">
            <Button Content="看看新形象" Click="OpenAchievement_Click" Style="{StaticResource GhostAction}" MinHeight="32" Padding="12,0" FontSize="12"/>
            <Button Content="继续弹" Click="DismissAchievement_Click" Style="{StaticResource GhostAction}" Margin="8,0,0,0" MinHeight="32" Padding="12,0" FontSize="12"/>
          </WrapPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="MemoryInvitation" Grid.ColumnSpan="2" Panel.ZIndex="31" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,240,42" Background="#F7F5EE" CornerRadius="14" Padding="18,14" MaxWidth="420">
      <StackPanel>
        <TextBlock x:Name="InvitationText" FontSize="13.5" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button Content="看看这段记忆" Click="OpenInvitation_Click" Style="{StaticResource PrimaryAction}" MinHeight="34" Padding="13,0" FontSize="12.5"/>
          <Button Content="这次先不了" Click="DismissInvitation_Click" Style="{StaticResource GhostAction}" Margin="8,0,0,0" MinHeight="34" Padding="13,0" FontSize="12.5"/>
        </StackPanel>
      </StackPanel>
    </Border>

  </Grid>
</Window>
