<Window x:Class="GuitarSoul.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pet="clr-namespace:GuitarSoul.App.Controls" Title="GuitarSoul" Icon="Assets/guitar-soul-icon-v1.ico" Width="1180" Height="800" MinWidth="1104" MinHeight="716" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#0A0F0C" FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- Powder-coated graphite, restrained bronze and readable ivory equipment markings. -->
    <SolidColorBrush x:Key="Paper" Color="#1A211D"/>
    <SolidColorBrush x:Key="PanelInk" Color="#E8E2D3"/>
    <SolidColorBrush x:Key="PanelMuted" Color="#ABB3A3"/>
    <SolidColorBrush x:Key="PanelLine" Color="#434C41"/>
    <SolidColorBrush x:Key="PanelField" Color="#141D18"/>
    <SolidColorBrush x:Key="PanelFieldLine" Color="#53604D"/>
    <SolidColorBrush x:Key="Forest" Color="#2E4A39"/>
    <SolidColorBrush x:Key="ForestHover" Color="#3A5A46"/>
    <SolidColorBrush x:Key="AccentInk" Color="#B9CBA0"/>
    <SolidColorBrush x:Key="Muted" Color="#ABB3A3"/>
    <SolidColorBrush x:Key="Mint" Color="#29392D"/>
    <SolidColorBrush x:Key="SceneInk" Color="#F4F1E4"/>
    <SolidColorBrush x:Key="SceneMuted" Color="#A9B5A6"/>
    <DrawingBrush x:Key="Tolex" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
      <DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#1B211B" Geometry="M0,0 H6 V6 H0 Z"/><GeometryDrawing Brush="#242A22" Geometry="M0,1 H2 V2 H0 Z M3,4 H5 V5 H3 Z"/></DrawingGroup></DrawingBrush.Drawing>
    </DrawingBrush>


    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource PanelInk}"/>
      <Setter Property="CaretBrush" Value="#E4CEA1"/><Setter Property="SelectionBrush" Value="#526648"/>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton x:Name="PageBefore" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#5A6650" CornerRadius="3" Margin="1,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton x:Name="PageAfter" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
        </Track>
        <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="PageBefore" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="PageAfter" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/></Trigger></Style.Triggers>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource PanelInk}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="PanelTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource PanelInk}"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource PanelInk}"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource PanelMuted}"/><Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{StaticResource PanelMuted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/>
    </Style>

    <Style x:Key="FieldCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource PanelInk}"/>
      <Setter Property="Background" Value="{StaticResource PanelField}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PanelFieldLine}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"/>
              <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="13,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding ItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
              <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#7C8778"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" IsHitTestVisible="False"/>
              <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade" Focusable="False">
                <Border Background="{StaticResource PanelField}" BorderBrush="{StaticResource PanelFieldLine}" BorderThickness="1" CornerRadius="8"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,0,0" Padding="4">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#9FB0A2"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Forest}"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value=".5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="LabelItem"><TextBlock Text="{Binding Label}" Foreground="{StaticResource PanelInk}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DataTemplate>
    <DataTemplate x:Key="NameItem"><TextBlock Text="{Binding Name}" Foreground="{StaticResource PanelInk}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DataTemplate>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="10,8"/><Setter Property="Foreground" Value="{StaticResource PanelInk}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Mint}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#384B39"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="PrimaryAction" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Forest}"/><Setter Property="Foreground" Value="#F6F4EA"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="46"/><Setter Property="Padding" Value="22,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="#8F7853" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{StaticResource ForestHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#243B2D"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#8FAE97"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Shell" Property="Background" Value="#29352D"/><Setter Property="Foreground" Value="#9BA695"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="GhostAction" TargetType="Button">
      <Setter Property="Background" Value="#28332A"/><Setter Property="Foreground" Value="{StaticResource PanelInk}"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="16,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderBrush" Value="{StaticResource PanelFieldLine}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#354336"/><Setter TargetName="Shell" Property="BorderBrush" Value="#758068"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#1E2A22"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Forest}"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value=".45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- The footswitch is the real listen action, not a decorative knob. -->
    <Style x:Key="ListenFootswitch" TargetType="Button" BasedOn="{StaticResource PrimaryAction}">
      <Setter Property="Background" Value="#354C39"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Pedal" Background="{TemplateBinding Background}" BorderBrush="#233328" BorderThickness="1" CornerRadius="3" Padding="12,5">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="29" Height="29" Margin="0,0,10,0"><Ellipse Fill="#7B8274" Stroke="#26352C" StrokeThickness="1"/><Ellipse Fill="#D4D6C9" Stroke="#A6AB9B" StrokeThickness="1" Margin="4"/><Ellipse Fill="#A9B0A1" Margin="9"/></Grid>
            <ContentPresenter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pedal" Property="Background" Value="#47614A"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pedal" Property="Background" Value="#24382B"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pedal" Property="BorderBrush" Value="#CC9A54"/><Setter TargetName="Pedal" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Pedal" Property="Background" Value="#29382D"/><Setter TargetName="Pedal" Property="BorderBrush" Value="#4C5F4B"/><Setter Property="Foreground" Value="#A6B59F"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>



    <Style x:Key="QuietToggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource SceneInk}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border Background="#33121C16" CornerRadius="8" Padding="12,8">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Box" Width="15" Height="15" CornerRadius="4" BorderBrush="#9FAE9C" BorderThickness="1.4" Background="#22FFFFFF" VerticalAlignment="Center"/>
            <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="9" Foreground="#1B2A1F" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Width="15" Margin="0,0,-15,0"/>
            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Box" Property="Background" Value="{StaticResource SceneInk}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SceneInk}"/>
            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SceneInk}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#E8C37B"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="PanelCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource PanelInk}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderBrush="#B9C0B2" BorderThickness="1.4" Background="{StaticResource PanelField}" VerticalAlignment="Center"/>
          <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="9" Foreground="#F6F4EA" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Width="16" Margin="0,0,-16,0"/>
          <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Box" Property="Background" Value="{StaticResource Forest}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Forest}"/>
            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Forest}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#E3B266"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="ModeSegment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource PanelMuted}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Shell" Background="Transparent" CornerRadius="2" Padding="10,6">
          <StackPanel Orientation="Horizontal"><Ellipse x:Name="ChannelLamp" Width="7" Height="7" Fill="#8E8976" Margin="0,0,7,0" VerticalAlignment="Center"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="#4A4C36"/><Setter TargetName="ChannelLamp" Property="Fill" Value="#C47B2E"/><Setter Property="Foreground" Value="{StaticResource PanelInk}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource PanelInk}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Forest}"/><Setter TargetName="Shell" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="PanelTabs" TargetType="TabControl">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TabPanel IsItemsHost="True" Grid.Row="0" Margin="24,6,24,0"/>
          <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Grid.Row="1"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="PanelTabItem" TargetType="TabItem">
      <Setter Property="Foreground" Value="#8B9488"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="Shell" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="0,10,0,9" Margin="0,0,26,0">
          <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource PanelInk}"/><Setter Property="Foreground" Value="{StaticResource PanelInk}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource PanelInk}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#8FAE97"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="PanelSlider" TargetType="Slider">
      <Setter Property="Height" Value="20"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid>
          <Border Height="5" Background="#0D1711" BorderBrush="#4A5843" BorderThickness="0,0,0,1" CornerRadius="2" VerticalAlignment="Center"/>
          <Track x:Name="PART_Track" VerticalAlignment="Center">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="5" Background="{StaticResource Forest}" CornerRadius="3" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="12" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Knob" BorderBrush="#101A13" BorderThickness="1" CornerRadius="2"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#ACA78A" Offset="0"/><GradientStop Color="#D7D1AF" Offset=".45"/><GradientStop Color="#737C61" Offset="1"/></LinearGradientBrush></Border.Background><Border Height="1" Background="#37402E" Margin="2,0" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="BorderBrush" Value="#D2B879"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="PanelMeter" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Border Background="#111B15" CornerRadius="3">
          <Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{StaticResource Forest}" CornerRadius="3" HorizontalAlignment="Left"/></Grid>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <DrawingBrush x:Key="DotDim" TileMode="Tile" Viewport="0,0,9,8" ViewportUnits="Absolute" Stretch="None">
      <DrawingBrush.Drawing><GeometryDrawing Brush="#36432F"><GeometryDrawing.Geometry><EllipseGeometry Center="2,4" RadiusX="1.5" RadiusY="1.5"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="DotBright" TileMode="Tile" Viewport="0,0,9,8" ViewportUnits="Absolute" Stretch="None">
      <DrawingBrush.Drawing><GeometryDrawing Brush="#7E9A6F"><GeometryDrawing.Geometry><EllipseGeometry Center="2,4" RadiusX="1.5" RadiusY="1.5"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="DottedProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid>
          <Rectangle Height="8" Fill="{StaticResource DotDim}"/>
          <Grid x:Name="PART_Track">
            <Rectangle x:Name="PART_Indicator" Height="8" Fill="{StaticResource DotBright}" HorizontalAlignment="Left"/>
          </Grid>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="QuietDisclosure" TargetType="Expander">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="HeaderShell" Background="Transparent" BorderBrush="{StaticResource PanelLine}" BorderThickness="0,1,0,0" Padding="0,13">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{StaticResource PanelMuted}" TextElement.FontSize="12.5"/>
                  <TextBlock Grid.Column="1" x:Name="Chevron" Text="&#xE70D;" FontFamily="Segoe Fluent Icons" Foreground="#8B9488" FontSize="9" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" CenterX="5" CenterY="5"/></Setter.Value></Setter></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderShell" Property="BorderBrush" Value="#C6C3B4"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" ContentSource="Content"/>
        </StackPanel>
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="WindowButton" TargetType="Button">
      <Setter Property="Width" Value="42"/><Setter Property="Height" Value="32"/><Setter Property="Foreground" Value="#B9C4B7"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Shell" Background="Transparent" CornerRadius="6">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#22FFFFFF"/><Setter Property="Foreground" Value="#F2EFE2"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="480"/></Grid.ColumnDefinitions>

    <!-- ============================ the room ============================ -->
    <Grid x:Name="PerformanceScene" Grid.Column="0" Background="#0A0F0C" ClipToBounds="True">
      <pet:RehearsalRoomBackdrop x:Name="RoomBackdrop" Level="{Binding Value, ElementName=LevelMeter}"/>

      <pet:SoundWave x:Name="SceneWave" VerticalAlignment="Bottom" Height="132" Margin="0,0,0,112"
                     PixelStyle="True" CenterGap="0.26" PixelUnit="4" IsHitTestVisible="False"
                     AutomationProperties.Name="实际接收声音的像素振幅包络"/>

      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,26,0,0">
        <TextBlock Text="GuitarSoul" Foreground="{StaticResource SceneInk}" FontSize="30" FontWeight="Bold"/>
        <TextBlock Text="你的小观众。" Foreground="{StaticResource SceneMuted}" FontSize="13" Margin="1,2,0,0"/>
        <TextBlock x:Name="SkyStatus" Text="本地时间 · 夜色" Foreground="#B6BDAA" FontSize="11" Margin="1,8,0,0" ToolTip="随本地时间连续变化的昼夜光影；日月轨迹为氛围模拟，月相为近似。"/>
      </StackPanel>

      <pet:PixelCat x:Name="CatPreview" Width="160" Height="168" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,88" Panel.ZIndex="3">
        <pet:PixelCat.Effect><DropShadowEffect Color="#040A06" BlurRadius="14" ShadowDepth="8" Direction="270" Opacity=".7"/></pet:PixelCat.Effect>
